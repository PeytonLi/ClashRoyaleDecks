# Clash Royale Deck Recommender — Environment Variables

# Clash Royale API key (get from https://developer.clashroyale.com)
CR_API_KEY=your_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clashroyale

# Stripe (for payment integration)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Usage limits
FREE_USAGE_LIMIT=3
