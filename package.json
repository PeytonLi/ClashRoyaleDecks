{
  "name": "clash-royale-decks",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo dev",
    "dev:services": "docker compose up -d --build",
    "dev:logs": "docker compose logs -f api db",
    "dev:stop": "docker compose down",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@assistant-ui/store": "0.2.9",
      "@assistant-ui/tap": "0.5.10",
      "@assistant-ui/react-ai-sdk": "1.3.21",
      "assistant-cloud": "0.1.27",
      "zustand": "5.0.13"
    }
  }
}
